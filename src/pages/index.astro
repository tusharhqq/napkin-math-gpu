---
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/500.css";
import "@fontsource/jetbrains-mono/600.css";
import "@fontsource/jetbrains-mono/700.css";
import "@phosphor-icons/web/regular";
import { GPU_PROFILES } from "../data/profiles";
import "../styles/global.css";

const h100 = GPU_PROFILES[0];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Estimate GPU compute, memory, transfer, communication, launch, and capacity limits from measured ceilings."
    />
    <meta name="theme-color" content="#07111f" />
    <title>GPU Napkin Math — estimate first, profile second</title>
  </head>
  <body>
    <a class="skip-link" href="#calculator">Skip to calculator</a>

    <div class="announcement" role="status">
      <span class="status-dot" aria-hidden="true"></span>
      <strong>NEW:</strong> open-source · contribute on GitHub
      <span aria-hidden="true">→</span>
    </div>

    <header class="site-header">
      <a class="brand" href="#top" aria-label="GPU Napkin Math home">
        GPU NAPKIN MATH
        <span>an open-source estimator for GPU engineers</span>
      </a>
      <nav aria-label="Primary navigation">
        <a href="#method">Method</a>
        <a href="#evidence">Evidence</a>
        <a href="#examples">Examples</a>
        <a href="https://github.com/tusharhqq/napkin-math-gpu" target="_blank" rel="noreferrer">
          GitHub <i class="ph ph-github-logo" aria-hidden="true"></i>
        </a>
      </nav>
    </header>

    <main id="top">
      <section class="hero" aria-labelledby="hero-title">
        <div>
          <p class="eyebrow">CPU → GPU → multi-GPU lower bounds</p>
          <h1 id="hero-title">estimate first. profile second.</h1>
          <p>A roofline model for the whole path—not just the kernel.</p>
        </div>
        <div class="hero-actions">
          <button class="button button-secondary" type="button" data-load-example>
            Load an example
          </button>
          <button class="button button-primary" type="button" data-run-estimate>
            <i class="ph ph-play-fill" aria-hidden="true"></i>
            Run the estimate
          </button>
        </div>
      </section>

      <section class="calculator-grid" id="calculator" aria-label="GPU workload estimator">
        <aside class="panel profile-panel" aria-labelledby="profile-heading">
          <div class="panel-heading">
            <span>1.</span>
            <h2 id="profile-heading">GPU profile</h2>
          </div>
          <p class="panel-intro">Select a device profile</p>

          <div class="profile-list" role="radiogroup" aria-label="GPU profile">
            {GPU_PROFILES.map((profile, index) => (
              <button
                class:list={["profile-option", { selected: index === 0 }]}
                type="button"
                role="radio"
                aria-checked={index === 0 ? "true" : "false"}
                data-profile={profile.id}
              >
                <span class="profile-dot" aria-hidden="true"></span>
                <span>
                  <strong>{profile.label}</strong>
                  <small>{profile.status}</small>
                </span>
              </button>
            ))}
          </div>

          <div class="profile-summary" aria-live="polite">
            <h3>Profile summary <span data-profile-short>(H100)</span></h3>
            <dl>
              <div><dt>BF16 compute</dt><dd data-profile-compute>{h100.computeTflops.bf16?.toFixed(0)} TFLOP/s</dd></div>
              <div><dt>HBM bandwidth</dt><dd data-profile-hbm>{(h100.hbmGbps / 1000).toFixed(1)} TB/s</dd></div>
              <div><dt>HBM capacity</dt><dd data-profile-capacity>{h100.capacityGb} GB</dd></div>
              <div><dt>CPU ↔ GPU</dt><dd data-profile-pcie>55 GB/s</dd></div>
              <div><dt>GPU ↔ GPU</dt><dd data-profile-g2g>393 GB/s</dd></div>
              <div><dt>Launch latency</dt><dd data-profile-launch>4.7 μs</dd></div>
            </dl>
            <footer>
              <span data-profile-source>Source: Modal full profile</span>
              <span data-profile-captured>Captured: 2026-08-08</span>
            </footer>
          </div>

          <details class="advanced-options">
            <summary>Advanced options</summary>
            <label for="dtype">Precision</label>
            <select id="dtype" data-input="dtype">
              <option value="bf16">BF16</option>
              <option value="fp16">FP16</option>
              <option value="fp8">FP8</option>
              <option value="tf32">TF32</option>
              <option value="fp32">FP32</option>
            </select>
          </details>
        </aside>

        <section class="panel worksheet-panel" aria-labelledby="worksheet-heading">
          <div class="panel-heading panel-heading-split">
            <div><span>2.</span><h2 id="worksheet-heading">Workload worksheet</h2><small>(edit inputs)</small></div>
            <p>Scenario: <strong data-scenario-name>LLM prefill · BF16</strong></p>
          </div>

          <div class="worksheet-header" aria-hidden="true">
            <span>Item</span><span>Symbol</span><span>Value</span><span>Units</span><span>Notes</span>
          </div>

          <div class="worksheet-group">
            <h3>Compute</h3>
            <label class="worksheet-row" for="flops">
              <span>FLOPs (total)</span><code>W</code>
              <input id="flops" data-input="flops" type="number" min="0" step="1e12" value="2e13" />
              <span>FLOPs</span><small>model forward</small>
            </label>
            <div class="worksheet-row output-row">
              <span>Compute time</span><code>W/F</code><output data-output="compute">0.028</output><span>s</span><small>= W / F</small>
            </div>
          </div>

          <div class="worksheet-group">
            <h3>HBM (device memory)</h3>
            <label class="worksheet-row" for="device-bytes">
              <span>HBM bytes moved</span><code>Q</code>
              <input id="device-bytes" data-input="deviceBytes" type="number" min="0" step="1e9" value="1.86e11" />
              <span>bytes</span><small>reads + writes</small>
            </label>
            <div class="worksheet-row output-row">
              <span>HBM bandwidth</span><code>M</code><output data-output="hbmBandwidth">3.00e12</output><span>B/s</span><small>from profile</small>
            </div>
            <div class="worksheet-row output-row">
              <span>HBM time</span><code>Q/M</code><output data-output="memory">0.062</output><span>s</span><small>= Q / M</small>
            </div>
          </div>

          <div class="worksheet-group">
            <h3>PCIe (host↔device)</h3>
            <label class="worksheet-row" for="h2d-bytes">
              <span>H2D bytes</span><code>P↑</code>
              <input id="h2d-bytes" data-input="h2dBytes" type="number" min="0" step="1e8" value="1e8" />
              <span>bytes</span><small>input transfer</small>
            </label>
            <label class="worksheet-row" for="d2h-bytes">
              <span>D2H bytes</span><code>P↓</code>
              <input id="d2h-bytes" data-input="d2hBytes" type="number" min="0" step="1e8" value="1e8" />
              <span>bytes</span><small>output transfer</small>
            </label>
            <div class="worksheet-row output-row">
              <span>PCIe time</span><code>P/B</code><output data-output="transfer">0.004</output><span>s</span><small data-transfer-note>two directions</small>
            </div>
          </div>

          <div class="worksheet-group">
            <h3>Inter-GPU (NVLink)</h3>
            <label class="worksheet-row" for="g2g-bytes">
              <span>Communicated bytes</span><code>N</code>
              <input id="g2g-bytes" data-input="g2gBytes" type="number" min="0" step="1e8" value="1e9" />
              <span>bytes</span><small>all-reduce, etc.</small>
            </label>
            <div class="worksheet-row output-row">
              <span>NVLink time</span><code>N/B</code><output data-output="g2g">0.003</output><span>s</span><small>= N / B</small>
            </div>
          </div>

          <div class="worksheet-group">
            <h3>Kernel launch</h3>
            <label class="worksheet-row" for="launches">
              <span>Kernel launches</span><code>K</code>
              <input id="launches" data-input="launches" type="number" min="0" step="1" value="1000" />
              <span>launches</span><small>from workload</small>
            </label>
            <div class="worksheet-row output-row">
              <span>Launch time</span><code>K×L</code><output data-output="launch">0.005</output><span>s</span><small data-launch-note>from profile</small>
            </div>
          </div>

          <fieldset class="execution-model">
            <legend>Execution model</legend>
            <label><input type="radio" name="execution" value="serial" /> Serial (no overlap)</label>
            <label class="selected"><input type="radio" name="execution" value="overlapped" checked /> Overlapped (concurrency)</label>
          </fieldset>
        </section>

        <aside class="panel result-panel" aria-labelledby="result-heading" aria-live="polite">
          <div class="panel-heading"><span>3.</span><h2 id="result-heading">Estimated lower bounds</h2></div>
          <p class="result-mode" data-result-mode>(overlapped)</p>

          <div class="result-summary">
            <p>Bottleneck: <strong data-bottleneck>HBM-bound</strong></p>
            <span>Estimated lower bound</span>
            <output data-total-ms>62 ms</output>
            <small>This is the best-case time given your inputs.</small>
          </div>

          <div class="resource-chart" aria-label="Resource floor times">
            <h3>Resource floors (time in ms)</h3>
            <div class="chart-axis" aria-hidden="true"><span>0</span><span>25</span><span>50</span><span>75</span><span>100%</span></div>
            <div class="resource-row" data-resource="compute"><span>Compute (W/F)</span><div><i></i></div><output>28 ms</output></div>
            <div class="resource-row" data-resource="memory"><span>HBM (Q/M)</span><div><i></i></div><output>62 ms</output></div>
            <div class="resource-row" data-resource="transfer"><span>PCIe (P/B)</span><div><i></i></div><output>4 ms</output></div>
            <div class="resource-row" data-resource="g2g"><span>Inter-GPU (N/B)</span><div><i></i></div><output>3 ms</output></div>
            <div class="resource-row" data-resource="launch"><span>Kernel launch (K×L)</span><div><i></i></div><output>5 ms</output></div>
          </div>

          <div class="how-to-read">
            <h3>How to read this</h3>
            <p>Each bar is the time floor when that resource runs alone. The longest floor predicts the bottleneck.</p>
            <p data-result-explanation>Your estimate is HBM-bound.</p>
          </div>
        </aside>
      </section>

      <section class="paper-section capacity-section" id="examples" aria-labelledby="capacity-heading">
        <div class="section-heading"><span>4.</span><h2 id="capacity-heading">Capacity fit checks</h2></div>
        <div class="capacity-grid">
          <div class="table-wrap">
            <table>
              <thead><tr><th>Check</th><th>Usage</th><th>Capacity</th><th>Headroom</th><th>Status</th></tr></thead>
              <tbody>
                <tr><td>HBM working set</td><td data-capacity-usage>186 GB</td><td data-capacity-limit>80 GB</td><td data-capacity-headroom>−106 GB</td><td data-capacity-status class="status-danger">Does not fit</td></tr>
                <tr><td>Weights</td><td data-capacity-row="weights">96 GB</td><td>—</td><td>—</td><td>included</td></tr>
                <tr><td>Activations</td><td data-capacity-row="activations">72 GB</td><td>—</td><td>—</td><td>included</td></tr>
                <tr><td>KV cache + workspace</td><td data-capacity-row="other">18 GB</td><td>—</td><td>—</td><td>included</td></tr>
              </tbody>
            </table>
          </div>
          <fieldset class="capacity-inputs">
            <legend>Quick capacity inputs (GB)</legend>
            <label>Weights <input data-input="weightsGb" type="number" min="0" value="96" /></label>
            <label>Activations <input data-input="activationsGb" type="number" min="0" value="72" /></label>
            <label>KV cache <input data-input="kvGb" type="number" min="0" value="12" /></label>
            <label>Workspace <input data-input="workspaceGb" type="number" min="0" value="6" /></label>
          </fieldset>
        </div>
        <p class="capacity-warning" data-capacity-warning>
          Exceeds HBM by 106 GB. Reduce batch, sequence length, or precision—or shard the workload.
        </p>
      </section>

      <section class="paper-section explanation-section" id="method" aria-labelledby="explanation-heading">
        <div class="section-heading"><span>5.</span><h2 id="explanation-heading">Explain this estimate</h2><small>(equations)</small></div>
        <div class="equation-grid">
          <div>
            <p>Compute one time floor for each resource, then take the maximum where stages overlap.</p>
            <dl class="equations">
              <div><dt>Compute</dt><dd>T<sub>comp</sub> = W / F</dd></div>
              <div><dt>HBM</dt><dd>T<sub>hbm</sub> = Q / M</dd></div>
              <div><dt>PCIe</dt><dd>T<sub>pcie</sub> = P↑ / B↑ + P↓ / B↓</dd></div>
              <div><dt>Inter-GPU</dt><dd>T<sub>g2g</sub> = N / B<sub>g2g</sub></dd></div>
              <div><dt>Launch</dt><dd>T<sub>launch</sub> = K × L</dd></div>
              <div><dt>Capacity</dt><dd>working set ≤ usable HBM</dd></div>
            </dl>
          </div>
          <div class="plugged-equations">
            <h3>Plug in your numbers</h3>
            <pre data-equation-output>T_comp   = 2.00e+13 / 7.17e+14 = 0.028 s
T_hbm    = 1.86e+11 / 3.00e+12 = 0.062 s
T_pcie   = 0.004 s
T_g2g    = 0.003 s
T_launch = 1000 × 4.66e-6 = 0.005 s</pre>
            <p class="equation-total" data-equation-total>T_est = max(0.028, 0.062, 0.004, 0.003, 0.005) = 0.062 s</p>
            <strong data-equation-bottleneck>Bottleneck = HBM</strong>
          </div>
        </div>
        <footer class="assumptions">
          <strong>Assumptions</strong>
          <span>Steady-state measured rates from the selected profile. Planning profiles are vendor ceilings, not achieved throughput.</span>
          <span>No pipeline bubbles. A napkin estimate is a lower bound, not a latency promise.</span>
        </footer>
      </section>

      <section class="evidence-section" id="evidence" aria-labelledby="evidence-heading">
        <div class="section-heading"><span>6.</span><h2 id="evidence-heading">Evidence & reproducibility</h2></div>
        <div class="evidence-grid">
          <div><h3>Profile source</h3><p data-footer-profile>Provider: Modal<br />Profile: H100 SXM 80GB<br />Measured: 2026-08-08<br />Method: microbench + roofline</p><a href="https://github.com/tusharhqq/napkin-math-gpu/blob/main/H100.md">See methodology →</a></div>
          <div><h3>What's measured</h3><ul><li>FLOP/s by dtype</li><li>HBM bandwidth</li><li>PCIe H2D/D2H</li><li>GPU-to-GPU bandwidth</li><li>Kernel launch latency</li></ul><a href="https://github.com/tusharhqq/napkin-math-gpu#readme">View raw numbers →</a></div>
          <div><h3>Export</h3><p>Save a scenario and share the exact inputs.</p><div class="export-actions"><button type="button" data-export-json>Export JSON</button><button type="button" data-copy-link>Copy share link</button></div></div>
          <div class="open-source-box"><h3>Open source</h3><p>Contribute improvements, new profiles, and examples.</p><a class="button button-secondary" href="https://github.com/tusharhqq/napkin-math-gpu" target="_blank" rel="noreferrer"><i class="ph ph-github-logo" aria-hidden="true"></i> View on GitHub</a></div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <p>GPU Napkin Math is MIT licensed. Use freely. Verify always.</p>
      <nav aria-label="Footer navigation"><a href="#method">Method</a><a href="#examples">Examples</a><a href="#evidence">Evidence</a><a href="https://github.com/tusharhqq/napkin-math-gpu/issues">Report an issue</a></nav>
    </footer>

    <script src="../scripts/analytics.ts"></script>
    <script src="../scripts/calculator.ts"></script>
  </body>
</html>
